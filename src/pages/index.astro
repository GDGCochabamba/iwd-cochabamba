---
import Layout from "../layouts/Layout.astro";
import Menu from "../components/Menu.astro";
import Banner from "../components/Banner.astro";
import EventInfo from "../components/EventInfo.astro";
import CallForSpeakers from "../components/CallForSpeakers.astro";
import AboutWinayTech from "../components/AboutWinayTech.astro";
import Communities from "../components/Communities.astro";
import WTMAmbassadors from "../components/WTMAmbassadors.astro";
import GDGProgram from "../components/GDGProgram.astro";
import Footer from "../components/Footer.astro";
import Speakers from "../components/Speakers.astro";
import Sponsors from "../components/Sponsors.astro";
import {
  formatEventDate,
  formatEventTime,
  getEventBySlug,
  getEventSpeakers,
  getEventSponsors,
} from "../lib/event";

const slug = import.meta.env.PUBLIC_EVENT_SLUG ?? "iwd-2026";
const event = await getEventBySlug(slug);

let participants: Awaited<ReturnType<typeof getEventSpeakers>> = [];
let sponsors: Awaited<ReturnType<typeof getEventSponsors>> = [];
if (event) {
  [participants, sponsors] = await Promise.all([
    getEventSpeakers(event.id),
    getEventSponsors(event.id),
  ]);
}

const title = event ? `${event.name} ${event.edition}` : "IWD Cochabamba";
const formattedDate = event ? formatEventDate(event) : undefined;
const formattedTime = event ? formatEventTime(event) : undefined;
---

<Layout title={title}>
  <main>
    <Menu />
    <Banner
      tagline={event?.tagline}
      registrationUrl={event?.registrationUrl}
    />
    <EventInfo
      date={formattedDate}
      time={formattedTime}
      venueName={event?.primaryVenue?.name}
      venueAddress={event?.primaryVenue?.address}
    />
    <CallForSpeakers />
    <AboutWinayTech />
    <Communities />
    <WTMAmbassadors />
    <GDGProgram />
    <Speakers participants={participants} />
    <Sponsors sponsors={sponsors} />
    <Footer />
  </main>
</Layout>

<style>
  @font-face {
    font-family: "Google Sans";
    src: url("../assets/fonts/GoogleSansDisplay-Regular.ttf") format("truetype");
  }

  body {
    font-family: "Google Sans", sans-serif;
  }
</style>
