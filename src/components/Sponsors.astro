---
import type { PublicSponsor } from "../lib/event";

interface Props {
  sponsors: PublicSponsor[];
}

const { sponsors } = Astro.props;

const TIER_ORDER: PublicSponsor["tier"][] = [
  "platinum",
  "gold",
  "silver",
  "bronze",
  "community",
  "media",
];

const grouped = TIER_ORDER.map((tier) => ({
  tier,
  items: sponsors.filter((s) => s.tier === tier),
})).filter((g) => g.items.length > 0);

const TIER_LABELS: Record<PublicSponsor["tier"], string> = {
  platinum: "Platinum",
  gold: "Gold",
  silver: "Silver",
  bronze: "Bronze",
  community: "Community",
  media: "Media",
};
---

{
  sponsors.length > 0 && (
    <section class="px-6 py-20 pt-0 md:px-10">
      <h2 class="flex-shrink-0 flex-grow-0 text-center text-[40px] mt-5 text-[#29292d]">
        Nuestros Auspiciadores
      </h2>
      <p class="flex-shrink-0 flex-grow-0 text-center text-[22px] text-[#4c555b]">
        Conoce a las empresas que apoyan el evento.
      </p>
      <div class="mt-14 flex flex-col gap-12">
        {grouped.map(({ tier, items }) => (
          <div>
            <h3 class="mb-6 text-center text-lg font-semibold uppercase tracking-wide text-[#4c555b]">
              {TIER_LABELS[tier]}
            </h3>
            <div class="flex flex-wrap items-center justify-center gap-x-16 gap-y-8">
              {items.map((s) =>
                s.url ? (
                  <a href={s.url} target="_blank" rel="noopener" title={s.name}>
                    {s.logoUrl ? (
                      <img
                        src={s.logoUrl}
                        alt={`${s.name} logo`}
                        loading="lazy"
                        class="m-auto h-20 w-auto max-w-[200px] object-contain"
                      />
                    ) : (
                      <span class="text-xl font-semibold text-[#29292d]">
                        {s.name}
                      </span>
                    )}
                  </a>
                ) : s.logoUrl ? (
                  <img
                    src={s.logoUrl}
                    alt={`${s.name} logo`}
                    loading="lazy"
                    class="m-auto h-20 w-auto max-w-[200px] object-contain"
                  />
                ) : (
                  <span class="text-xl font-semibold text-[#29292d]">
                    {s.name}
                  </span>
                ),
              )}
            </div>
          </div>
        ))}
      </div>
    </section>
  )
}
