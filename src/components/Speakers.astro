---
import logoLinkedin from "../assets/images/social/linkedin.svg";
import logoFacebook from "../assets/images/social/facebook.svg";
import logoInstagram from "../assets/images/social/instagram.svg";
import logoTwitter from "../assets/images/social/twitter.svg";
import logoGithub from "../assets/images/social/github.svg";
import logoYoutube from "../assets/images/social/youtube.svg";
import logoWeb from "../assets/images/social/web.svg";
import { Image } from "astro:assets";
import type { PopulatedParticipant } from "../lib/event";

interface Props {
  participants: PopulatedParticipant[];
}

const { participants } = Astro.props;

const SOCIAL_ICONS = {
  linkedin: logoLinkedin,
  twitter: logoTwitter,
  facebook: logoFacebook,
  instagram: logoInstagram,
  github: logoGithub,
  youtube: logoYoutube,
  web: logoWeb,
} as const;

type SocialKey = keyof typeof SOCIAL_ICONS;
---

{
  participants.length > 0 && (
    <section class="speakers-section px-6 py-20 md:px-10">
      <h2 class="text-center text-3xl font-medium leading-normal text-[black]">
        Speakers
      </h2>
      <div class="mt-16 grid grid-cols-1 gap-5 md:grid-cols-1 lg:grid-cols-2 xl:grid-cols-3">
        {participants.map(({ participant, person }) => (
          <div class="speaker-card rounded-md border-2 border-solid border-slate-200 p-3 pl-5">
            <div class="flex flex-col items-center justify-between lg:flex-row lg:justify-around">
              <div class="lg:w-1/3">
                {person.photoUrl ? (
                  <img
                    src={person.photoUrl}
                    alt={`${person.name} photo`}
                    loading="lazy"
                    class="h-52 w-52 rounded-2xl object-cover md:mr-3 md:h-44 md:w-44"
                  />
                ) : (
                  <div class="m-auto grid h-52 w-52 place-items-center rounded-2xl bg-slate-200 text-4xl text-slate-500 md:h-44 md:w-44">
                    {person.name.charAt(0)}
                  </div>
                )}
              </div>
              <div class="flex flex-col items-center justify-center lg:w-2/3">
                <h5 class="mb-1 mt-2 text-center font-light lg:mt-0">
                  {person.name}
                </h5>
                {participant.talkTitle && (
                  <p class="mb-1 text-center text-sm font-medium text-[#0f7c67]">
                    {participant.talkTitle}
                  </p>
                )}
                <p class="mb-2 text-center text-xs font-thin text-black text-opacity-50 lg:mt-1 lg:text-sm">
                  {participant.bioOverride ?? person.bio ?? ""}
                </p>
                <div class="flex items-center space-x-2">
                  {(Object.entries(person.socials) as [SocialKey, string][]).map(
                    ([kind, href]) =>
                      href && SOCIAL_ICONS[kind] ? (
                        <a href={href} target="_blank" rel="noopener">
                          <Image
                            class="h-5 w-5 lg:h-6 lg:w-6"
                            src={SOCIAL_ICONS[kind]}
                            alt={`${kind} link`}
                          />
                        </a>
                      ) : null,
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  )
}

<style>
  .speakers-section {
    background: #d1ece3;
  }
  .speaker-card {
    border: 2px solid #8a8a8a;
    border-bottom: 6px solid #8a8a8a;
    background: white;
  }
</style>
