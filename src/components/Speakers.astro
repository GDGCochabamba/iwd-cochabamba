---
import logoLinkedin from "../assets/images/social/linkedin.svg";
import logoFacebook from "../assets/images/social/facebook.svg";
import logoInstagram from "../assets/images/social/instagram.svg";
import logoTwitter from "../assets/images/social/twitter.svg";
import logoGithub from "../assets/images/social/github.svg";
import logoYoutube from "../assets/images/social/youtube.svg";
import logoWeb from "../assets/images/social/web.svg";
import { Image } from "astro:assets";
import type { PopulatedParticipant } from "../lib/event";

interface Props {
  participants: PopulatedParticipant[];
}

const { participants } = Astro.props;

const SOCIAL_ICONS = {
  linkedin: logoLinkedin,
  twitter: logoTwitter,
  facebook: logoFacebook,
  instagram: logoInstagram,
  github: logoGithub,
  youtube: logoYoutube,
  web: logoWeb,
} as const;

type SocialKey = keyof typeof SOCIAL_ICONS;

const AVATAR_COLORS = ["#4285f4", "#ea4335", "#f9ab00", "#34a853"];

function initials(name: string): string {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word[0])
    .join("")
    .toUpperCase();
}

function colorFor(name: string): string {
  let sum = 0;
  for (const char of name) sum += char.charCodeAt(0);
  return AVATAR_COLORS[sum % AVATAR_COLORS.length];
}

// Some bios continue with the talk abstract after a "**Talk title**" marker;
// the card already shows the talk title, so keep only the person's bio.
function shortBio(text: string | undefined): string {
  if (!text) return "";
  const beforeTalk = text.split("**")[0].trim();
  return beforeTalk || text.replaceAll("**", "").trim();
}
---

{
  participants.length > 0 && (
    <section class="speakers-section px-6 py-20 md:px-10">
      <h2 class="text-center text-3xl font-medium leading-normal text-[black]">
        Speakers
      </h2>
      <div class="mx-auto mt-12 grid max-w-6xl grid-cols-2 gap-3 sm:grid-cols-[repeat(auto-fill,minmax(200px,1fr))] sm:gap-5">
        {participants.map(({ participant, person }) => {
          const bio = shortBio(participant.bioOverride ?? person.bio);
          const socials = (
            Object.entries(person.socials) as [SocialKey, string][]
          ).filter(([kind, href]) => href && SOCIAL_ICONS[kind]);
          return (
            <article class="flex flex-col items-center gap-2 rounded-2xl border border-[#b9dccf] bg-white px-3 py-5 text-center sm:px-4 sm:py-6">
              {person.photoUrl ? (
                <img
                  src={person.photoUrl}
                  alt={person.name}
                  loading="lazy"
                  class="mb-1 h-[72px] w-[72px] rounded-full object-cover sm:h-24 sm:w-24"
                />
              ) : (
                <div
                  class="mb-1 flex h-[72px] w-[72px] items-center justify-center rounded-full text-xl font-bold text-white sm:h-24 sm:w-24 sm:text-[1.75rem]"
                  style={`background-color: ${colorFor(person.name)}`}
                  aria-hidden="true"
                >
                  {initials(person.name)}
                </div>
              )}
              <h3 class="text-base font-semibold text-gray-900">
                {person.name}
              </h3>
              {participant.talkTitle && (
                <p class="text-sm font-medium leading-snug text-[#0f7c67]">
                  {participant.talkTitle}
                </p>
              )}
              {bio && (
                <p class="line-clamp-3 text-xs leading-relaxed text-gray-500 sm:text-[0.8rem]">
                  {bio}
                </p>
              )}
              {socials.length > 0 && (
                <div class="mt-auto flex items-center gap-2 pt-1">
                  {socials.map(([kind, href]) => (
                    <a
                      href={href}
                      target="_blank"
                      rel="noopener"
                      aria-label={`${person.name} en ${kind}`}
                    >
                      <Image class="h-5 w-5" src={SOCIAL_ICONS[kind]} alt="" />
                    </a>
                  ))}
                </div>
              )}
            </article>
          );
        })}
      </div>
    </section>
  )
}

<style>
  .speakers-section {
    background: #d1ece3;
  }
</style>
